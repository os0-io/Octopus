[Unit]
Description=Octopus Process Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/octopus
ExecStart=/root/.bun/bin/bun run /root/octopus/src/index.js
Restart=always
RestartSec=2
RuntimeDirectory=octopus
RuntimeDirectoryMode=0755
Environment=OCTOPUS_HEADLESS=1
Environment=OCTOPUS_STATE_DIR=/run/octopus
Environment=OCTOPUS_STATE_PATH=/run/octopus/state.json

[Install]
WantedBy=multi-user.target
